  {"name": "hind_foot", "sided": true, "head": "hock", "tail": "hind_ball", "parent": "shin"},
  {"name": "hind_paw", "sided": true, "head": "hind_ball", "tail": "hind_toe", "parent": "hind_foot"},
  {"name": "front_ik", "sided": true, "head": "wrist", "tail": "front_toe", "parent": "root", "deform": false},
  {"name": "hind_ik", "sided": true, "head": "hock", "tail": "hind_ball", "parent": "root", "deform": false}
 ],
