  {"name": "ear", "sided": true, "head": "ear_base", "tail": "ear_tip", "parent": "head"},
  {"name": "upper_arm", "sided": true, "head": "shoulder", "tail": "elbow", "parent": "chest"},
  {"name": "forearm", "sided": true, "head": "elbow", "tail": "wrist", "parent": "upper_arm"},
